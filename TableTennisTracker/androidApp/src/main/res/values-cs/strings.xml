    <string name="help_rpe_level_5_6">5–6: Střední – dýcháš rychleji, už to dá zabrat</string>
    <string name="help_rpe_level_7_8">7–8: Těžké – mluví se špatně, jdeš na hranu</string>
    <string name="help_rpe_level_9_10">9–10: Maximální úsilí – naplno, dlouho nevydržíš</string>
    <string name="help_rpe_tip">Tip: Většina tréninků by měla být v rozmezí 5–7.</string>

