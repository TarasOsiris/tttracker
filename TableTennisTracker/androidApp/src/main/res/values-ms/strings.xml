    <!-- Help -->
    <string name="help_icon_content_description">Tunjukkan bantuan</string>
    <string name="help_rpe_title">Apakah RPE?</string>
    <string name="help_rpe_description">RPE (Rate of Perceived Exertion) mengukur sejauh mana anda rasa badan anda bekerja keras semasa bersenam.</string>
    <string name="help_rpe_scale_intro">Skala 1-10 membantu anda menjejak intensiti latihan:</string>
    <string name="help_rpe_level_1_2">1-2: Sangat Mudah - Aktiviti ringan, boleh bercakap dengan mudah</string>
    <string name="help_rpe_level_3_4">3-4: Mudah - Rentak selesa, masih boleh berbual</string>
    <string name="help_rpe_level_5_6">5-6: Sederhana - Pernafasan lebih kuat, agak mencabar</string>
    <string name="help_rpe_level_7_8">7-8: Sukar - Sukar bercakap, memaksa diri</string>
    <string name="help_rpe_level_9_10">9-10: Usaha Maksimum - Intensiti habis-habisan, tidak dapat dikekalkan</string>
    <string name="help_rpe_tip">Petua: Kebanyakan sesi latihan sepatutnya dalam julat 5-7.</string>

