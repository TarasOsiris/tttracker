    <!-- Help -->
    <string name="help_icon_content_description">Toon hulp</string>
    <string name="help_rpe_title">Wat is RPE?</string>
    <string name="help_rpe_description">RPE (Rate of Perceived Exertion) geeft aan hoe zwaar je de inspanning tijdens het sporten zelf ervaart.</string>
    <string name="help_rpe_scale_intro">Met de schaal van 1-10 houd je de intensiteit van je training bij:</string>
    <string name="help_rpe_level_1_2">1-2: Heel licht - Lichte activiteit, praten gaat makkelijk</string>
    <string name="help_rpe_level_3_4">3-4: Licht - Comfortabel tempo, een gesprek is mogelijk</string>
    <string name="help_rpe_level_5_6">5-6: Gemiddeld - Zwaarder ademen, enige uitdaging</string>
    <string name="help_rpe_level_7_8">7-8: Zwaar - Praten is lastig, je gaat tot het uiterste</string>
    <string name="help_rpe_level_9_10">9-10: Maximaal - Alles geven, niet vol te houden</string>
    <string name="help_rpe_tip">Tip: de meeste trainingen horen tussen 5 en 7 te liggen.</string>

