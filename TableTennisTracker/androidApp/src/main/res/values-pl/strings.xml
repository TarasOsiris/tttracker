    <!-- Help -->
    <string name="help_icon_content_description">Pokaż pomoc</string>
    <string name="help_rpe_title">Co to jest RPE?</string>
    <string name="help_rpe_description">RPE (Rate of Perceived Exertion, czyli subiektywna ocena wysiłku) mierzy, jak ciężko według ciebie pracuje twoje ciało podczas ćwiczeń.</string>
    <string name="help_rpe_scale_intro">Skala od 1 do 10 pomaga śledzić intensywność treningu:</string>
    <string name="help_rpe_level_1_2">1–2: Bardzo lekki – lekka aktywność, swobodnie rozmawiasz</string>
    <string name="help_rpe_level_3_4">3–4: Lekki – komfortowe tempo, da się rozmawiać</string>
    <string name="help_rpe_level_5_6">5–6: Umiarkowany – szybszy oddech, odczuwalny wysiłek</string>
    <string name="help_rpe_level_7_8">7–8: Ciężki – trudno mówić, dajesz z siebie dużo</string>
    <string name="help_rpe_level_9_10">9–10: Maksymalny wysiłek – pełna moc, nie do utrzymania</string>
    <string name="help_rpe_tip">Wskazówka: większość treningów powinna mieścić się w przedziale 5–7.</string>

