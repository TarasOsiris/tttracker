    <string name="help_rpe_title">Vad är RPE?</string>
    <string name="help_rpe_description">RPE (Rate of Perceived Exertion) mäter hur hårt du upplever att kroppen arbetar under träningen.</string>
    <string name="help_rpe_scale_intro">Skalan 1–10 hjälper dig att följa träningens intensitet:</string>
    <string name="help_rpe_level_1_2">1–2: Mycket lätt – lätt aktivitet, du kan prata obehindrat</string>
    <string name="help_rpe_level_3_4">3–4: Lätt – bekvämt tempo, det går att samtala</string>
    <string name="help_rpe_level_5_6">5–6: Måttlig – tyngre andning, viss utmaning</string>
    <string name="help_rpe_level_7_8">7–8: Hård – svårt att prata, du pressar dig</string>
    <string name="help_rpe_level_9_10">9–10: Maximal ansträngning – allt du har, går inte att hålla länge</string>
    <string name="help_rpe_tip">Tips: De flesta träningspass bör ligga mellan 5 och 7.</string>

