    <!-- Help -->
    <string name="help_icon_content_description">Hiện trợ giúp</string>
    <string name="help_rpe_title">RPE là gì?</string>
    <string name="help_rpe_description">RPE (Rate of Perceived Exertion – mức gắng sức cảm nhận) đo mức độ bạn cảm thấy cơ thể đang phải làm việc vất vả khi tập luyện.</string>
    <string name="help_rpe_scale_intro">Thang điểm 1–10 giúp bạn theo dõi cường độ tập luyện:</string>
    <string name="help_rpe_level_1_2">1–2: Rất nhẹ – Vận động nhẹ, nói chuyện dễ dàng</string>
    <string name="help_rpe_level_3_4">3–4: Nhẹ – Nhịp độ thoải mái, vẫn trò chuyện được</string>
    <string name="help_rpe_level_5_6">5–6: Vừa phải – Thở gấp hơn, có chút thử thách</string>
    <string name="help_rpe_level_7_8">7–8: Nặng – Khó nói chuyện, đang cố gắng hết mình</string>
    <string name="help_rpe_level_9_10">9–10: Tối đa sức – Dốc toàn lực, không thể duy trì lâu</string>
    <string name="help_rpe_tip">Mẹo: Phần lớn buổi tập nên ở mức 5–7.</string>

