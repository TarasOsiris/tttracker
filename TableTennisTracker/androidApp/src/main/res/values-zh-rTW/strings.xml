	<!-- Help -->
	<string name="help_icon_content_description">顯示說明</string>
	<string name="help_rpe_title">什麼是 RPE？</string>
	<string name="help_rpe_description">RPE（自覺費力程度）衡量你在運動時身體感覺有多費力。</string>
	<string name="help_rpe_scale_intro">1–10 分的量表有助於追蹤訓練強度：</string>
	<string name="help_rpe_level_1_2">1–2：非常輕鬆 — 輕度活動，可以輕鬆說話</string>
	<string name="help_rpe_level_3_4">3–4：輕鬆 — 舒適的節奏，可以交談</string>
	<string name="help_rpe_level_5_6">5–6：中等 — 呼吸變急促，有點挑戰</string>
	<string name="help_rpe_level_7_8">7–8：吃力 — 難以說話，需要逼自己</string>
	<string name="help_rpe_level_9_10">9–10：最大強度 — 全力以赴，無法持續</string>
	<string name="help_rpe_tip">提示：大多數訓練應落在 5–7 區間。</string>

