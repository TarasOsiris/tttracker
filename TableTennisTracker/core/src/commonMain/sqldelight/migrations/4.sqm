-- Migration from version 4 to 5: change tracking for the iOS iCloud sync. Created on Android too,
-- where nothing writes to them; the triggers that fill them are installed on iOS only.

CREATE TABLE IF NOT EXISTS cloud_sync_state (
    id INTEGER PRIMARY KEY NOT NULL CHECK (id = 0),
    outbox_seq INTEGER NOT NULL DEFAULT 0,
    is_enabled INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE IF NOT EXISTS cloud_sync_outbox (
    record_id TEXT PRIMARY KEY NOT NULL,
    table_name TEXT NOT NULL,
    is_purged INTEGER NOT NULL DEFAULT 0,
    changed_at INTEGER NOT NULL,
    seq INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS cloud_sync_outbox_seq ON cloud_sync_outbox(seq);

CREATE TABLE IF NOT EXISTS cloud_sync_record (
    record_id TEXT PRIMARY KEY NOT NULL,
    system_fields TEXT NOT NULL
);
