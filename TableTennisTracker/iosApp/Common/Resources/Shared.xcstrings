    "help_rpe_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (معدل الجهد المدرك) يقيس مدى شعورك بعمل جسمك بجهد أثناء التمرين."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion, vnímaná námaha) vyjadřuje, jak moc podle tvého pocitu tělo při cvičení pracuje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion) misst, wie hart du deinen Körper während des Trainings arbeiten fühlst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion) measures how hard you feel your body is working during exercise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El RPE (Escala de Esfuerzo Percibido) mide lo duro que sientes que trabaja tu cuerpo durante el ejercicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le RPE (Rate of Perceived Exertion) mesure l'effort perçu pendant l'exercice."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion) बताता है कि व्यायाम के दौरान आपका शरीर कितनी मेहनत महसूस कर रहा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion) mengukur seberapa berat tubuh Anda terasa bekerja saat berolahraga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'RPE (Rate of Perceived Exertion) misura quanto senti che il tuo corpo sta lavorando durante l'esercizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE（自覚的運動強度）は運動中に体がどれだけきついと感じるかを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE(자각적 운동 강도)는 운동 중 몸이 얼마나 힘들게 느끼는지를 나타냅니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion) mengukur sejauh mana anda rasa badan anda bekerja keras semasa bersenam."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion) geeft aan hoe zwaar je de inspanning tijdens het sporten zelf ervaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion, czyli subiektywna ocena wysiłku) mierzy, jak ciężko według ciebie pracuje twoje ciało podczas ćwiczeń."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion) mede o quão duro você sente o corpo trabalhar durante o exercício."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion) mäter hur hårt du upplever att kroppen arbetar under träningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion) คือการวัดว่าคุณรู้สึกว่าร่างกายทำงานหนักแค่ไหนระหว่างออกกำลังกาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Algılanan Zorluk Derecesi), egzersiz sırasında vücudunuzun ne kadar zorlandığını hissetmenizi ölçer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion) вимірює, наскільки інтенсивно ви відчуваєте навантаження під час тренування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE (Rate of Perceived Exertion – mức gắng sức cảm nhận) đo mức độ bạn cảm thấy cơ thể đang phải làm việc vất vả khi tập luyện."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE（自觉用力程度）衡量你在运动中感到身体用力的程度。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPE（自覺費力程度）衡量你在運動時身體感覺有多費力。"
          }
        }
      }
    },
    "help_rpe_level_1_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: سهل جدًا - نشاط خفيف، يمكنك التحدث بسهولة"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–2: Velmi lehké – lehká aktivita, v klidu mluvíš"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: Sehr einfach - Leichte Aktivität, leicht zu sprechen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: Very Easy - Light activity, can talk easily"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: Muy fácil - Actividad ligera, puedes hablar con facilidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2 : Très facile - Activité légère, on peut parler facilement"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: बहुत आसान - हल्की गतिविधि, आसानी से बात कर सकते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: Sangat mudah - Aktivitas ringan, bisa berbicara dengan mudah"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: Molto facile - Attività leggera, puoi parlare facilmente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2：とても楽 - 軽い活動、楽に会話できる"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: 매우 쉬움 - 가벼운 활동, 쉽게 대화 가능"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: Sangat Mudah - Aktiviti ringan, boleh bercakap dengan mudah"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: Heel licht - Lichte activiteit, praten gaat makkelijk"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–2: Bardzo lekki – lekka aktywność, swobodnie rozmawiasz"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: Muito fácil - Atividade leve, dá para conversar"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–2: Mycket lätt – lätt aktivitet, du kan prata obehindrat"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: ง่ายมาก - กิจกรรมเบาๆ พูดคุยได้สบาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: Çok kolay - Hafif aktivite, rahatça konuşabilirsiniz"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2: Дуже легко - Легка активність, можна вільно розмовляти"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–2: Rất nhẹ – Vận động nhẹ, nói chuyện dễ dàng"
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-2：非常轻松 - 轻度活动，可以轻松说话"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1–2：非常輕鬆 — 輕度活動，可以輕鬆說話"
          }
        }
      }
    },
