        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने अभ्यास, मैच और प्रतिद्वंद्वी अपने सभी डिवाइस पर एक जैसे रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
