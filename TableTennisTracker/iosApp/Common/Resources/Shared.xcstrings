    "debug_clear_database_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف جميع التدريبات من قاعدة البيانات نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trvale smaže všechny tréninky z databáze. Tuto akci nelze vrátit zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Trainingseinheiten dauerhaft aus der Datenbank löschen. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently delete all training sessions from the database. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar permanentemente todas las sesiones de entrenamiento de la base de datos. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer définitivement toutes les séances d'entraînement de la base de données. Cette action ne peut pas être annulée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेटाबेस से सभी अभ्यास स्थायी रूप से हटाएं। यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus semua latihan dari database secara permanen. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente tutti gli allenamenti dal database. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データベースからすべての練習を完全に削除します。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터베이스에서 모든 훈련을 영구적으로 삭제합니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padam semua sesi latihan daripada pangkalan data secara kekal. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijder alle trainingen definitief uit de database. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwale usuń wszystkie treningi z bazy danych. Tej operacji nie można cofnąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclua permanentemente todas as sessões de treino do banco de dados. Esta ação não pode ser desfeita."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radera alla träningspass i databasen permanent. Det här går inte att ångra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบเซสชันฝึกซ้อมทั้งหมดออกจากฐานข้อมูลอย่างถาวร การดำเนินการนี้ไม่สามารถเลิกทำได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veritabanından tüm antrenmanları kalıcı olarak silin. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безповоротно видалити всі тренування з бази даних. Цю дію неможливо скасувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa vĩnh viễn tất cả buổi tập khỏi cơ sở dữ liệu. Không thể hoàn tác thao tác này."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久删除数据库中的所有训练。此操作无法撤消。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久刪除資料庫中的所有訓練。此動作無法復原。"
          }
        }
      }
    },
