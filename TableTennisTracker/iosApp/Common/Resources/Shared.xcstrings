    "settings_icloud_sync_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بتدريباتك ومبارياتك وخصومك متطابقة على جميع أجهزتك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tréninky, zápasy a soupeři budou stejní na všech tvých zařízeních."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte deine Einheiten, Spiele und Gegner auf all deinen Geräten auf demselben Stand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your sessions, matches and opponents the same on all your devices."
