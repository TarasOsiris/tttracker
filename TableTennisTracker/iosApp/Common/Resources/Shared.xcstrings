    "widget_streak_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد الأسابيع المتتالية التي تدربت فيها، وأفضل سلسلة لك."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolik týdnů v řadě trénuješ a tvoje nejlepší série."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Wochen in Folge du trainiert hast – und deine beste Serie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many weeks in a row you have trained, and your best run."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántas semanas seguidas has entrenado y tu mejor racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de semaines d'affilée vous vous êtes entraîné, et votre meilleure série."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप लगातार कितने सप्ताह से अभ्यास कर रहे हैं, और आपका सबसे लंबा रिकॉर्ड।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa minggu berturut-turut kamu berlatih, dan rekor terbaikmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quante settimane di fila ti sei allenato e la tua serie migliore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何週連続で練習しているかと、これまでの最長記録。"
