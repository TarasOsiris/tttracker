        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 주 연속으로 훈련했는지와 최고 기록."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berapa minggu berturut-turut anda telah berlatih, dan rekod terbaik anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveel weken op rij je hebt getraind, en je beste reeks."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile tygodni z rzędu trenujesz i jaki jest twój rekord."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantas semanas seguidas você treinou e sua melhor sequência."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur många veckor i rad du har tränat, och ditt rekord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณซ้อมต่อเนื่องมากี่สัปดาห์แล้ว และสถิติดีที่สุดของคุณ"
