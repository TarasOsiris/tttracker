    "opponents_info_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخصوم الذين تضيفهم هنا سيكونون متاحين للاختيار السريع عند تسجيل المباريات في جلسات التدريب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soupeře, které tu přidáš, pak rychle vybereš při zapisování zápasů do tréninků."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegner, die du hier hinzufügst, stehen dir zur schnellen Auswahl zur Verfügung, wenn du Spiele in deinen Trainingseinheiten erfasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opponents you add here will be available for quick selection when recording matches in your training sessions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los oponentes que añadas aquí estarán disponibles para selección rápida al registrar partidos en tus sesiones de entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les adversaires ajoutés ici seront disponibles pour une sélection rapide lors de l'enregistrement des matchs dans vos séances d'entraînement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ जोड़े गए प्रतिद्वंद्वी आपके प्रशिक्षण सत्रों में मैच दर्ज करते समय त्वरित चयन के लिए उपलब्ध होंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lawan yang Anda tambahkan di sini akan tersedia untuk pilihan cepat saat mencatat pertandingan di sesi latihan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avversari aggiunti qui saranno disponibili per una selezione rapida quando registri le partite nelle tue sessioni di allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで追加した対戦相手は、トレーニングセッションで試合を記録する際に素早く選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 추가한 상대는 훈련 세션에서 경기를 기록할 때 빠르게 선택할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lawan yang anda tambah di sini boleh dipilih dengan pantas semasa merekod perlawanan dalam sesi latihan anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tegenstanders die je hier toevoegt, kun je snel kiezen wanneer je wedstrijden bij je trainingen vastlegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodani tu przeciwnicy będą dostępni do szybkiego wyboru, gdy zapisujesz mecze w swoich treningach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os oponentes adicionados aqui estarão disponíveis para seleção rápida ao registrar partidas nas suas sessões de treino."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motståndare du lägger till här kan du snabbt välja när du registrerar matcher i dina träningspass."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คู่แข่งที่คุณเพิ่มไว้ที่นี่จะเลือกได้ทันทีเมื่อบันทึกแมตช์ในเซสชันฝึกซ้อมของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buraya eklediğiniz rakipler, antrenman seanslarınızda maç kaydederken hızlı seçim için kullanılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Суперники, яких ви додасте тут, будуть доступні для швидкого вибору при записі матчів у ваших тренуваннях."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đối thủ bạn thêm ở đây sẽ có sẵn để chọn nhanh khi ghi lại trận đấu trong buổi tập."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在此添加的对手将在记录训练会话中的比赛时可快速选择。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡新增的對手，可在訓練中記錄比賽時快速選擇。"
          }
        }
      }
    },
