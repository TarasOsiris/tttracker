        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je trainingen, wedstrijden en tegenstanders gelijk op al je apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
