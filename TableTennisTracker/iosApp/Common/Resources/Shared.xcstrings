    "settings_icloud_turned_off" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُذفت بيانات هذا التطبيق في iCloud، لذا أُوقفت المزامنة. لم يُحذف أي شيء من هذا الجهاز."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data této aplikace na iCloudu byla smazána, a proto se synchronizace vypnula. Z tohoto zařízení se nic neodstranilo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die iCloud-Daten dieser App wurden gelöscht, daher wurde die Synchronisierung deaktiviert. Auf diesem Gerät wurde nichts entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app's iCloud data was deleted, so sync was turned off. Nothing on this device was removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron los datos de iCloud de esta app, así que se desactivó la sincronización. No se eliminó nada de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données iCloud de cette app ont été supprimées, la synchronisation a donc été désactivée. Rien n'a été supprimé sur cet appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ऐप का iCloud डेटा हटा दिया गया, इसलिए सिंक बंद कर दिया गया। इस डिवाइस से कुछ नहीं हटाया गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data iCloud aplikasi ini telah dihapus, sehingga sinkronisasi dimatikan. Tidak ada yang dihapus dari perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati iCloud di questa app sono stati eliminati, quindi la sincronizzazione è stata disattivata. Su questo dispositivo non è stato rimosso nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリのiCloudデータが削除されたため、同期をオフにしました。このデバイスのデータは削除されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 iCloud 데이터가 삭제되어 동기화가 꺼졌습니다. 이 기기에서는 아무것도 삭제되지 않았습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data iCloud apl ini telah dipadam, jadi penyegerakan dimatikan. Tiada apa-apa pada peranti ini yang dibuang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De iCloud-gegevens van deze app zijn verwijderd, dus synchronisatie is uitgeschakeld. Er is niets van dit apparaat verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane tej aplikacji w iCloud zostały usunięte, więc synchronizacja została wyłączona. Nic nie zostało usunięte z tego urządzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do iCloud deste app foram apagados, então a sincronização foi desativada. Nada foi removido deste dispositivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appens iCloud-data raderades, så synkningen stängdes av. Inget på den här enheten togs bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูล iCloud ของแอปนี้ถูกลบแล้ว จึงปิดการซิงค์ ไม่มีข้อมูลใดในอุปกรณ์นี้ถูกลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamanın iCloud verileri silindi, bu yüzden eşzamanlama kapatıldı. Bu aygıttan hiçbir şey kaldırılmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані цього застосунку в iCloud видалено, тому синхронізацію вимкнено. На цьому пристрої нічого не видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu iCloud của ứng dụng này đã bị xóa nên tính năng đồng bộ hóa đã tắt. Không có gì trên thiết bị này bị xóa."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此应用的 iCloud 数据已被删除，因此同步已关闭。此设备上的内容均未删除。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
