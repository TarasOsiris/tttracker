    "settings_icloud_account_changed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر حساب iCloud الخاص بك، لذا أُوقفت المزامنة. شغّلها مجددًا للمزامنة مع هذا الحساب."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvůj účet iCloud se změnil, a proto se synchronizace vypnula. Zapni ji znovu, pokud chceš synchronizovat s tímto účtem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iCloud-Account hat sich geändert, daher wurde die Synchronisierung deaktiviert. Schalte sie wieder ein, um mit diesem Account zu synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iCloud account changed, so sync was turned off. Turn it on again to sync with this account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta de iCloud cambió, así que se desactivó la sincronización. Vuelve a activarla para sincronizar con esta cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte iCloud a changé, la synchronisation a donc été désactivée. Réactivez-la pour synchroniser avec ce compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका iCloud खाता बदल गया है, इसलिए सिंक बंद कर दिया गया। इस खाते से सिंक करने के लिए इसे फिर से चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun iCloud Anda berubah, sehingga sinkronisasi dimatikan. Nyalakan lagi untuk menyinkronkan dengan akun ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account iCloud è cambiato, quindi la sincronizzazione è stata disattivata. Riattivala per sincronizzare con questo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudアカウントが変更されたため、同期をオフにしました。このアカウントと同期するには、もう一度オンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 계정이 변경되어 동기화가 꺼졌습니다. 이 계정으로 동기화하려면 다시 켜세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akaun iCloud anda telah bertukar, jadi penyegerakan dimatikan. Hidupkan semula untuk menyegerakkan dengan akaun ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je iCloud-account is gewijzigd, dus synchronisatie is uitgeschakeld. Schakel het opnieuw in om met dit account te synchroniseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto iCloud się zmieniło, więc synchronizacja została wyłączona. Włącz ją ponownie, aby synchronizować z tym kontem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta do iCloud mudou, então a sincronização foi desativada. Ative-a de novo para sincronizar com esta conta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt iCloud-konto har bytts, så synkningen stängdes av. Slå på den igen för att synka med det här kontot."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัญชี iCloud ของคุณเปลี่ยนไป จึงปิดการซิงค์ เปิดอีกครั้งเพื่อซิงค์กับบัญชีนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud hesabınız değişti, bu yüzden eşzamanlama kapatıldı. Bu hesapla eşzamanlamak için yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш обліковий запис iCloud змінився, тому синхронізацію вимкнено. Увімкніть її знову, щоб синхронізувати з цим обліковим записом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản iCloud của bạn đã thay đổi nên tính năng đồng bộ hóa đã tắt. Hãy bật lại để đồng bộ hóa với tài khoản này."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iCloud 账户已更改，因此同步已关闭。如需与此账户同步，请重新打开。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iCloud 帳號已變更，因此同步已關閉。如要與此帳號同步，請重新開啟。"
          }
        }
      }
    },
