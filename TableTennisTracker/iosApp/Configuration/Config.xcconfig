TEAM_ID=

PRODUCT_NAME=TableTennisTracker
PRODUCT_BUNDLE_IDENTIFIER=xyz.tleskiv.tt.TableTennisTracker$(TEAM_ID)

CURRENT_PROJECT_VERSION=18
MARKETING_VERSION=1.3.8

// Pro and iCloud sync in a sandbox-receipt (TestFlight) install. App Review installs carry a sandbox
// receipt too, so /ship archives a build headed for review with SANDBOX_FEATURES=NO.
SANDBOX_FEATURES=YES

// RevenueCat: Debug talks to RevenueCat's Test Store, so the paywall works without App Store Connect
// products. A Test Store key must never ship — the SDK refuses it in a release build.
REVENUECAT_API_KEY = appl_blGverWOWltsWAVPIlvZmSjivOl
REVENUECAT_API_KEY[config=Debug] = test_uoxEDxKykcfuEhpvTvGThKXUgRE
