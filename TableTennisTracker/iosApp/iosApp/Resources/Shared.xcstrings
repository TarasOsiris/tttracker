    "help_rpe_level_5_6" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6: متوسط - تنفس أقوى، بعض التحدي"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6: Moderat - Schwereres Atmen, etwas Herausforderung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6: Moderate - Breathing harder, some challenge"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6: Moderado - Respiración más intensa, algo de desafío"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6 : Modéré - Respiration plus difficile, léger défi"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6: मध्यम - सांस तेज़, थोड़ी चुनौती"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6: Sedang - Napas lebih berat, ada tantangan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6: Moderato - Respiro più affannoso, un po' di sfida"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6：中程度 - 呼吸がきつくなり、少し負荷"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6: 보통 - 호흡이 거칠어짐, 약간의 도전"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6: Moderado - Respiração mais forte, algum desafio"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6: Orta - Nefes daha zor, biraz zorluk"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6: Помірно - Дихання важче, певне навантаження"
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5-6：中等 - 呼吸更急促，有些挑战"
          }
        }
      }
    },
    "help_rpe_level_7_8" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7-8: صعب - صعب التحدث، تدفع نفسك"
          }
        },
        "de" : {
