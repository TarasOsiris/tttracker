          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9-10: Sforzo massimo - Intensità totale, non sostenibile"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9-10：最大努力 - 全力の強度、持続できない"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9-10: 최대 노력 - 전력, 지속하기 어려움"
          }
