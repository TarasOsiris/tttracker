    "delete_opponent_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا أيضًا إلى حذف جميع المباريات مع هذا الخصم. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden auch alle Spiele mit diesem Gegner gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will also delete all matches with this opponent. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto también eliminará todos los partidos con este oponente. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera également tous les matchs avec cet adversaire. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे इस प्रतिद्वंद्वी के साथ सभी मैच भी हट जाएंगे। यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini juga akan menghapus semua pertandingan dengan lawan ini. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno eliminati anche tutti i match con questo avversario. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この対戦相手との全ての試合も削除されます。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 상대방과의 모든 경기도 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso também excluirá todos os jogos com este oponente. Esta ação não pode ser desfeita."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu rakiple yapılan tüm maçlar da silinecek. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це також видалить усі матчі з цим суперником. Цю дію неможливо скасувати."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这也将删除与此对手的所有比赛。此操作无法撤销。"
          }
        }
      }
    },
