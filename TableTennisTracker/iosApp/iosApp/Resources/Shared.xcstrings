            "value" : "7-8：困难 - 难以说话，需要逼自己"
          }
        }
      }
    },
    "help_rpe_level_9_10" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9-10: أقصى جهد - شدة كاملة، لا يمكن الاستمرار"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9-10: Maximale Anstrengung - Volle Intensität, nicht durchzuhalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9-10: Max Effort - All-out intensity, cannot sustain"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9-10: Esfuerzo máximo - Intensidad total, no se puede sostener"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "9-10 : Effort maximal - Intensité totale, impossible à tenir"
